rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isDeveloper(uid) {
      return uid == 'Jj7pIHpuqBNzaRT5i9FSoqRWTnD3';
    }
    function isReservedDeveloperName(name) {
      return name.matches('(?i)^(admin|ad|desarrollador)$');
    }
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','provider','createdAt','updatedAt','settings'])
        && request.resource.data.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','displayName','photoURL','provider','updatedAt','settings']);
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /pushTokens/{tokenId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token','updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() <= 4096;
      }
    }
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['visibleName','bio','socialLinks','rank','developerBadge','updatedAt'])
        && request.resource.data.visibleName is string
        && request.resource.data.visibleName.size() >= 1
        && request.resource.data.visibleName.size() <= 50
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.socialLinks is list
        && request.resource.data.socialLinks.size() <= 3
        && (request.resource.data.rank == 'Equipo de Desarrollo'
          ? isDeveloper(request.auth.uid) && request.resource.data.developerBadge == true
          : request.resource.data.rank in ['Usuario','Estudiante','Profesor','Adulto']
            && request.resource.data.developerBadge == false)
        && (!isReservedDeveloperName(request.resource.data.visibleName)
          || (isDeveloper(request.auth.uid) && request.resource.data.rank == 'Equipo de Desarrollo'));
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /media/{mediaId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && mediaId == 'images'
          && request.resource.data.keys().hasOnly(['avatarData','bannerData','updatedAt'])
          && (!('avatarData' in request.resource.data)
            || (request.resource.data.avatarData is string
              && request.resource.data.avatarData.size() <= 220000
              && request.resource.data.avatarData.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
          && (!('bannerData' in request.resource.data)
            || (request.resource.data.bannerData is string
              && request.resource.data.bannerData.size() <= 500000
              && request.resource.data.bannerData.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')));
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /parentLinks/{linkId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.studentUid
        && request.resource.data.keys().hasOnly(['studentUid','studentEmail','parentEmail','parentUid','status','createdAt','acceptedAt'])
        && request.resource.data.studentEmail == request.auth.token.email
        && request.resource.data.parentEmail is string
        && request.resource.data.parentEmail != request.auth.token.email
        && request.resource.data.parentUid == null
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.rank == 'Estudiante'
        && request.resource.data.createdAt == request.time;
      allow get: if request.auth != null
        && (resource.data.studentUid == request.auth.uid
          || resource.data.parentUid == request.auth.uid
          || (resource.data.status == 'pending'
            && request.auth.token.email_verified == true
            && resource.data.parentEmail == request.auth.token.email));
      allow list: if request.auth != null
        && (resource.data.studentUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.status == 'pending'
        && request.auth.token.email_verified == true
        && resource.data.parentEmail == request.auth.token.email
        && request.auth.uid != resource.data.studentUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentUid','status','acceptedAt'])
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.acceptedAt == request.time
        && get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.rank == 'Adult'
        && get(/databases/$(database)/documents/publicProfiles/$(resource.data.studentUid)).data.rank == 'Estudiante'
        && get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.email != request.auth.token.email;
      allow delete: if request.auth != null
        && (resource.data.studentUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
